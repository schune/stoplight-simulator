{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Stoplight Simulator",
        "supportEmail": "lukeschuneman@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://stoplight-simulator.web.app/__/auth/handler",
          "https://stoplight-simulator.firebaseapp.com/__/auth/handler",
          "https://stoplightsimulator.com/__/auth/handler",
          "https://www.stoplightsimulator.com/__/auth/handler"
        ]
      }
    },
    "authorizedDomains": [
      "localhost",
      "stoplight-simulator.web.app",
      "stoplight-simulator.firebaseapp.com",
      "stoplightsimulator.com",
      "www.stoplightsimulator.com"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/robots.txt",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sitemap.xml",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
